<Window x:Class="RevitAgent.UiTestApp.ChildWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Child Settings"
        Width="360" Height="260"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <StackPanel Margin="10">
        <TextBlock Text="Child value" />
        <TextBox x:Name="txtChild" Margin="0,0,0,8" />
        <!-- Data that merely contains a "forbidden" word must not make the dialog unusable (like Revit's
             New Schedule category list with "Security Devices"). Regression for UiSafety, 2026-11-20. -->
        <ListBox x:Name="lstCategories" Height="60" Margin="0,0,0,8">
            <ListBoxItem Content="Rooms" />
            <ListBoxItem Content="Security Devices" />
            <ListBoxItem Content="Data Devices" />
        </ListBox>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <!-- A form's function button named "Delete ..." (like Revit's Schedule Properties "Delete Field") must not
                 make the form unusable: it is not the answer to a delete confirmation. Regression for UiSafety, 2026-11-25. -->
            <Button x:Name="btnChildDeleteField" Content="Delete Field" Width="80" Margin="0,0,6,0" />
            <Button x:Name="btnChildOk" Content="OK" Width="80" Margin="0,0,6,0" IsDefault="True" Click="OnOk" />
            <Button x:Name="btnChildCancel" Content="Cancel" Width="80" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
