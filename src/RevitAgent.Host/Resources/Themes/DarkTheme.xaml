<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================================= -->
    <!-- DARK THEME (SLATE / OLED FRIENDLY, HIGH CONTRAST WCAG AA/AAA)              -->
    <!-- ========================================================================= -->

    <!-- Surfaces & Canvas -->
    <SolidColorBrush x:Key="BrushWindowBg" Color="#0F172A"/>
    <SolidColorBrush x:Key="BrushCardBg" Color="#1B2336"/>
    <SolidColorBrush x:Key="BrushCardBorder" Color="#334155"/>
    <SolidColorBrush x:Key="BrushInputBg" Color="#111827"/>
    <SolidColorBrush x:Key="BrushInputBorder" Color="#475569"/>
    <SolidColorBrush x:Key="BrushHeaderBarBg" Color="#111827"/>
    <SolidColorBrush x:Key="BrushHeaderBarBorder" Color="#334155"/>
    <SolidColorBrush x:Key="BrushListItemHover" Color="#1E293B"/>

    <!-- Typography -->
    <SolidColorBrush x:Key="BrushTextPrimary" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="#94A3B8"/>
    <SolidColorBrush x:Key="BrushTextSubtle" Color="#64748B"/>
    <SolidColorBrush x:Key="BrushTextHeaderAccent" Color="#38BDF8"/>

    <!-- Accent / Primary Action (Blue 600 - WCAG AA compliant on White) -->
    <SolidColorBrush x:Key="BrushAccentPrimary" Color="#2563EB"/>
    <SolidColorBrush x:Key="BrushAccentHover" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="BrushAccentPressed" Color="#1E40AF"/>
    <SolidColorBrush x:Key="BrushAccentBorder" Color="#60A5FA"/>
    <SolidColorBrush x:Key="BrushAccentForeground" Color="#FFFFFF"/>

    <!-- Neutral Button States -->
    <SolidColorBrush x:Key="BrushButtonBg" Color="#1E293B"/>
    <SolidColorBrush x:Key="BrushButtonHover" Color="#334155"/>
    <SolidColorBrush x:Key="BrushButtonPressed" Color="#0F172A"/>
    <SolidColorBrush x:Key="BrushButtonBorder" Color="#334155"/>
    <SolidColorBrush x:Key="BrushButtonForeground" Color="#F8FAFC"/>

    <!-- Success (Emerald) -->
    <SolidColorBrush x:Key="BrushSuccess" Color="#059669"/>
    <SolidColorBrush x:Key="BrushSuccessBg" Color="#064E3B"/>
    <SolidColorBrush x:Key="BrushSuccessBorder" Color="#059669"/>
    <SolidColorBrush x:Key="BrushSuccessText" Color="#34D399"/>
    <SolidColorBrush x:Key="BrushSuccessDot" Color="#10B981"/>

    <!-- Warning (Amber - Dark foreground text #0F172A for 8.3:1 contrast) -->
    <SolidColorBrush x:Key="BrushWarning" Color="#F59E0B"/>
    <SolidColorBrush x:Key="BrushWarningHover" Color="#D97706"/>
    <SolidColorBrush x:Key="BrushWarningBorder" Color="#FBBF24"/>
    <SolidColorBrush x:Key="BrushWarningForeground" Color="#0F172A"/>
    <SolidColorBrush x:Key="BrushWarningBg" Color="#78350F"/>
    <SolidColorBrush x:Key="BrushWarningText" Color="#FBBF24"/>
    <SolidColorBrush x:Key="BrushWarningDot" Color="#F59E0B"/>

    <!-- Danger (Red 600 - WCAG AA compliant with White text) -->
    <SolidColorBrush x:Key="BrushDanger" Color="#DC2626"/>
    <SolidColorBrush x:Key="BrushDangerHover" Color="#B91C1C"/>
    <SolidColorBrush x:Key="BrushDangerBorder" Color="#F87171"/>
    <SolidColorBrush x:Key="BrushDangerForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushDangerBg" Color="#7F1D1D"/>
    <SolidColorBrush x:Key="BrushDangerText" Color="#F87171"/>
    <SolidColorBrush x:Key="BrushDangerDot" Color="#EF4444"/>

    <!-- Offline / Standby Status -->
    <SolidColorBrush x:Key="BrushOfflineBg" Color="#1E293B"/>
    <SolidColorBrush x:Key="BrushOfflineBorder" Color="#334155"/>
    <SolidColorBrush x:Key="BrushOfflineText" Color="#94A3B8"/>
    <SolidColorBrush x:Key="BrushOfflineDot" Color="#64748B"/>

    <!-- Tooltip -->
    <SolidColorBrush x:Key="BrushToolTipBg" Color="#1B2336"/>
    <SolidColorBrush x:Key="BrushToolTipBorder" Color="#334155"/>
    <SolidColorBrush x:Key="BrushToolTipText" Color="#F8FAFC"/>

    <!-- Toast Notifications -->
    <SolidColorBrush x:Key="BrushToastBg" Color="#1E293B"/>
    <SolidColorBrush x:Key="BrushToastBorder" Color="#334155"/>
    <SolidColorBrush x:Key="BrushToastSuccess" Color="#10B981"/>
    <SolidColorBrush x:Key="BrushToastInfo" Color="#3B82F6"/>
    <SolidColorBrush x:Key="BrushToastWarning" Color="#F59E0B"/>
    <SolidColorBrush x:Key="BrushToastDanger" Color="#EF4444"/>

    <!-- Legacy Compatibility Aliases -->
    <SolidColorBrush x:Key="BgDark" Color="#0F172A"/>
    <SolidColorBrush x:Key="CardBg" Color="#1B2336"/>
    <SolidColorBrush x:Key="CardBorder" Color="#334155"/>
    <SolidColorBrush x:Key="InputBg" Color="#111827"/>
    <SolidColorBrush x:Key="InputBorder" Color="#475569"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>
    <SolidColorBrush x:Key="AccentPrimary" Color="#2563EB"/>

</ResourceDictionary>
