<UserControl x:Class="RevitAgent.Host.Views.RunHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:RevitAgent.Host.ViewModels"
             xmlns:models="clr-namespace:RevitAgent.Host.Models"
             xmlns:converters="clr-namespace:RevitAgent.Host.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:RunHistoryViewModel}"
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:BoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter" Inverted="True"/>
        <converters:NullToVisibilityConverter x:Key="InvertedNullToVisibilityConverter" Inverted="True"/>

        <!-- Verdict Filter Button Base -->
        <Style x:Key="FilterBtnBase" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource BrushButtonBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushButtonBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <Style x:Key="FilterBtnAll" TargetType="Button" BasedOn="{StaticResource FilterBtnBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentVerdictFilter}" Value="ALL">
                    <Setter Property="Background" Value="{DynamicResource BrushAccentPrimary}"/>
                    <Setter Property="Foreground" Value="{DynamicResource BrushAccentForeground}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentBorder}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FilterBtnPass" TargetType="Button" BasedOn="{StaticResource FilterBtnBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentVerdictFilter}" Value="PASS">
                    <Setter Property="Background" Value="{DynamicResource BrushAccentPrimary}"/>
                    <Setter Property="Foreground" Value="{DynamicResource BrushAccentForeground}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentBorder}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FilterBtnFail" TargetType="Button" BasedOn="{StaticResource FilterBtnBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentVerdictFilter}" Value="FAIL">
                    <Setter Property="Background" Value="{DynamicResource BrushAccentPrimary}"/>
                    <Setter Property="Foreground" Value="{DynamicResource BrushAccentForeground}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentBorder}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FilterBtnSuspect" TargetType="Button" BasedOn="{StaticResource FilterBtnBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentVerdictFilter}" Value="SUSPECT">
                    <Setter Property="Background" Value="{DynamicResource BrushAccentPrimary}"/>
                    <Setter Property="Foreground" Value="{DynamicResource BrushAccentForeground}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentBorder}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FilterBtnError" TargetType="Button" BasedOn="{StaticResource FilterBtnBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentVerdictFilter}" Value="ERROR">
                    <Setter Property="Background" Value="{DynamicResource BrushAccentPrimary}"/>
                    <Setter Property="Foreground" Value="{DynamicResource BrushAccentForeground}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentBorder}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FilterBtnRunning" TargetType="Button" BasedOn="{StaticResource FilterBtnBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentVerdictFilter}" Value="RUNNING">
                    <Setter Property="Background" Value="{DynamicResource BrushAccentPrimary}"/>
                    <Setter Property="Foreground" Value="{DynamicResource BrushAccentForeground}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentBorder}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,2,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Toolbar: Title, Count, Filters, Search, Refresh -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="{DynamicResource Str_CardRunHistory}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushTextHeaderAccent}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding RunCountDisplay}" HorizontalAlignment="Right" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" VerticalAlignment="Center"/>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Verdict Filters -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource FilterBtnAll}" Content="{DynamicResource Str_FilterAll}" 
                                Command="{Binding FilterVerdictCommand}" CommandParameter="ALL"/>
                        <Button Style="{StaticResource FilterBtnPass}" Content="✓ PASS" 
                                Command="{Binding FilterVerdictCommand}" CommandParameter="PASS"/>
                        <Button Style="{StaticResource FilterBtnFail}" Content="✗ FAIL" 
                                Command="{Binding FilterVerdictCommand}" CommandParameter="FAIL"/>
                        <Button Style="{StaticResource FilterBtnSuspect}" Content="⚠ SUSPECT" 
                                Command="{Binding FilterVerdictCommand}" CommandParameter="SUSPECT"/>
                        <Button Style="{StaticResource FilterBtnError}" Content="⚡ ERROR" 
                                Command="{Binding FilterVerdictCommand}" CommandParameter="ERROR"/>
                        <Button Style="{StaticResource FilterBtnRunning}" Content="⏳ RUNNING" 
                                Command="{Binding FilterVerdictCommand}" CommandParameter="RUNNING"/>
                    </StackPanel>

                    <!-- Search Box & Refresh -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBox Width="200" Padding="8,4" Text="{Binding SuiteFilter, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock IsHitTestVisible="False" Text="{DynamicResource Str_FilterSuite}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="8,0,0,0" Foreground="{DynamicResource BrushTextSubtle}" FontSize="11"
                                       Visibility="{Binding SuiteFilter, Converter={StaticResource InvertedNullToVisibilityConverter}}"/>
                        </Grid>
                        <Button Content="🔄" ToolTip="{DynamicResource Str_BtnReloadConfig}" Command="{Binding RefreshCommand}" Padding="8,4"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Content: Empty State vs Grouped ListView -->
            <Grid Grid.Row="1">
                <!-- Empty State -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasRuns, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                    <TextBlock Text="📁" FontSize="44" HorizontalAlignment="Center" Foreground="{DynamicResource BrushTextSubtle}" Opacity="0.35" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource Str_TxtNoRuns}" FontSize="12" Foreground="{DynamicResource BrushTextSubtle}" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Grouped Runs ListView -->
                <ListView Background="{DynamicResource BrushInputBg}" BorderBrush="{DynamicResource BrushCardBorder}" 
                          Foreground="{DynamicResource BrushTextPrimary}"
                          ItemsSource="{Binding RunsView}"
                          Visibility="{Binding HasRuns, Converter={StaticResource BoolToVisibilityConverter}}">
                    
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BrushHeaderBarBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="0,0,0,1" Padding="8,4" Margin="0,4,0,2">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushAccentPrimary}"/>
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>

                    <ListView.View>
                        <GridView>
                            <!-- Verdict Badge -->
                            <GridViewColumn Header="{DynamicResource Str_ColVerdict}" Width="85">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type models:RunHistoryItem}">
                                        <Border CornerRadius="4" Padding="6,2" Background="{Binding VerdictBrush}" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Verdict}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Suite Name -->
                            <GridViewColumn Header="{DynamicResource Str_ColSuite}" Width="160" DisplayMemberBinding="{Binding Suite}"/>

                            <!-- Run ID -->
                            <GridViewColumn Header="{DynamicResource Str_ColRunId}" Width="200" DisplayMemberBinding="{Binding Id}"/>

                            <!-- Trigger -->
                            <GridViewColumn Header="{DynamicResource Str_ColTrigger}" Width="70" DisplayMemberBinding="{Binding Trigger}"/>

                            <!-- Started Time -->
                            <GridViewColumn Header="{DynamicResource Str_ColStarted}" Width="135" DisplayMemberBinding="{Binding FormattedStarted}"/>

                            <!-- Duration -->
                            <GridViewColumn Header="{DynamicResource Str_ColDuration}" Width="70" DisplayMemberBinding="{Binding DurationText}"/>

                            <!-- Actions -->
                            <GridViewColumn Header="{DynamicResource Str_ColActions}" Width="190">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type models:RunHistoryItem}">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{DynamicResource Str_BtnOpenReport}" 
                                                    Command="{Binding DataContext.OpenReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding HasReportHtml}"
                                                    Padding="6,3" Margin="0,0,4,0" FontSize="11"/>
                                            <Button Content="{DynamicResource Str_BtnOpenFolder}" 
                                                    Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="6,3" FontSize="11"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Grid>
    </Border>
</UserControl>
