<UserControl x:Class="RevitAgent.Host.Views.AddinAllowlistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:RevitAgent.Host.Converters">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </UserControl.Resources>
    <!-- Page "Allowed add-ins": the owner's allowlist for Revit's "Security - Unsigned Add-In" prompt. Styles/brushes come from the main window. -->
    <Grid Margin="0,2,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Explanation -->
        <Border Grid.Row="0" Background="{DynamicResource BrushWarningBg}" BorderBrush="{DynamicResource BrushWarningBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str_AddinTitle}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushWarningText}"/>
                <TextBlock Text="{DynamicResource Str_AddinHelp}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource BrushWarningText}" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding FilePath}" FontSize="10" Foreground="{DynamicResource BrushWarningText}" Opacity="0.8" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Add / edit form -->
        <Border Grid.Row="1" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Str_AddinLblName}" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource Str_AddinTipName}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Str_AddinLblPath}" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" Text="{Binding EditPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource Str_AddinTipPath}"/>
                <Button Grid.Row="1" Grid.Column="2" Margin="6,0,0,6" Content="{DynamicResource Str_AddinBtnBrowse}" Command="{Binding BrowseCommand}"/>

                <CheckBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,4" IsChecked="{Binding UseFolderPattern}" Content="{DynamicResource Str_AddinChkPattern}"
                          Foreground="{DynamicResource BrushTextPrimary}" FontSize="11"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Str_AddinLblFolder}" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" VerticalAlignment="Center"
                           Visibility="{Binding UseFolderPattern, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <ComboBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" Width="320" FontSize="11" Margin="0,0,0,6"
                          ItemsSource="{Binding FolderSegments}" SelectedIndex="{Binding PatternSegmentIndex, Mode=TwoWay}"
                          Visibility="{Binding UseFolderPattern, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource Str_AddinLblPreview}" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" VerticalAlignment="Center"/>
                <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,6" IsReadOnly="True" Text="{Binding PatternPreview, Mode=OneWay}"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource Str_AddinLblNote}" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" VerticalAlignment="Center"/>
                <DockPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="6,0,0,0">
                        <Button Style="{DynamicResource PrimaryButton}" Content="{DynamicResource Str_AddinBtnSave}" Command="{Binding SaveCommand}"/>
                        <Button Content="{DynamicResource Str_AddinBtnClear}" Command="{Binding ClearFormCommand}"/>
                    </StackPanel>
                    <TextBox Text="{Binding EditNote, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
            </Grid>
        </Border>

        <!-- List -->
        <Border Grid.Row="2" Background="{DynamicResource BrushCardBg}" BorderBrush="{DynamicResource BrushCardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="{DynamicResource Str_AddinBtnReload}" Command="{Binding ReloadCommand}"/>
                    <TextBlock Text="{DynamicResource Str_AddinListTitle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushTextHeaderAccent}" VerticalAlignment="Center"/>
                </DockPanel>
                <StackPanel Grid.Row="1" Margin="0,0,0,6">
                    <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource BrushSuccessText}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource BrushDangerText}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding FileError}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource BrushDangerText}"
                               Visibility="{Binding FileError, Converter={StaticResource NullToVisibilityConverter}}"/>
                </StackPanel>
                <ListView Grid.Row="2" Background="{DynamicResource BrushInputBg}" BorderBrush="{DynamicResource BrushCardBorder}" Foreground="{DynamicResource BrushTextPrimary}"
                          ItemsSource="{Binding Items}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{DynamicResource Str_AddinColEnabled}" Width="70">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="{DynamicResource Str_AddinColName}" Width="170" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="{DynamicResource Str_AddinColPattern}" Width="420" DisplayMemberBinding="{Binding PathPattern}"/>
                            <GridViewColumn Header="{DynamicResource Str_AddinColNote}" Width="150" DisplayMemberBinding="{Binding Note}"/>
                            <GridViewColumn Header="{DynamicResource Str_AddinColAdded}" Width="115" DisplayMemberBinding="{Binding AddedAtDisplay}"/>
                            <GridViewColumn Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{DynamicResource Str_AddinBtnEdit}"
                                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            <Button Style="{DynamicResource DangerButton}" Content="{DynamicResource Str_AddinBtnRemove}"
                                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</UserControl>
